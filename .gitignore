__pycache__/
*.pyc
mix.wav
/tmp/

# generated by theme/tools/build.py preview — the HTML previews + shots ARE
# committed on purpose (so the theme can be eyeballed on GitHub / before a
# Blogger upload); regenerate with: python3 theme/tools/build.py all
theme/preview/*
!theme/preview/.gitkeep
!theme/preview/README.md
!theme/preview/*.html
!theme/preview/*.png
!theme/preview/img/
!theme/preview/img/*.png
